{
  "appId": "com.neotokyo.neoqc",
  "productName": "Neo Service",
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "assets/icon.ico",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "artifactName": "Neo-Service-Setup-${version}.${ext}",
    "shortcutName": "Neo Service",
    "uninstallDisplayName": "Neo Service ${version}",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "Neo-Service.exe"
  },
  "publish": {
    "provider": "github",
    "owner": "akruunnithan21-ship-it",
    "repo": "neoqc"
  },
  "files": [
    "**/*",
    "!__pycache__/**",
    "!**/__pycache__/**",
    "!dashboard/**",
    "!action_plan_pdf.html",
    "!build-pdf.js",
    "!report-harness.html",
    "!database-hardening.sql",
    "!**/*.md",
    "!.claude/**",
    "!.github/**",
    "!*.log",
    "!*.pdf",
    "!sql/**",
    "!tests/**",
    "!dev/**",
    "!docs/**",
    "!build/**"
  ],
  "asarUnpack": [
    "assets/diagnostics/**",
    "*.py",
    "assets/benchmarks/**"
  ],
  "directories": {
    "output": "dist"
  }
}
