{
  "appId": "com.neotokyo.neoqc",
  "productName": "NeoQC",
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "assets/icon.ico",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "artifactName": "NeoQC-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "NeoQC.exe"
  },
  "publish": {
    "provider": "github",
    "owner": "akruunnithan21-ship-it",
    "repo": "neoqc"
  },
  "files": [
    "**/*",
    "!__pycache__/**",
    "!**/__pycache__/**",
    "!dashboard/**",
    "!action_plan_pdf.html",
    "!build-pdf.js",
    "!report-harness.html",
    "!database-hardening.sql",
    "!**/*.md",
    "!.claude/**",
    "!.github/**",
    "!*.log",
    "!*.pdf"
  ],
  "asarUnpack": [
    "assets/diagnostics/**",
    "*.py",
    "assets/benchmarks/**"
  ],
  "directories": {
    "output": "dist"
  }
}
