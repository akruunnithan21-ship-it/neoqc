[Unit]
Description=Neo Tokyo customer website (service.neotokyo.in, served on 127.0.0.1:8097)

# A user service, like the configurator test copy and the NAS phone app: it
# lives in ~/.config/systemd/user, starts at boot (lingering is on for this
# user) and needs no sudo to install, update or restart.
[Service]
WorkingDirectory=%h/neo-tracker
Environment=PORT=8097
Environment=HOST=127.0.0.1
ExecStart=/usr/local/bin/node %h/neo-tracker/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
